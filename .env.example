# Copy this file to .env.local and fill in only what you need.
# Everything is optional — LectureLab runs fully locally with Ollama.

# Where Ollama is running (default shown).
OLLAMA_URL=http://127.0.0.1:11434

# Optional: YouTube Data API v3 key for real video recommendations.
# Free from https://console.cloud.google.com/ (enable "YouTube Data API v3").
# You can also paste it in Settings inside the app instead.
YOUTUBE_API_KEY=

# Optional: where to keep the database and uploaded files (default ./data).
LECTURELAB_DATA_DIR=
